  "duas": {
    "iftaar_dua_1": {
      "arabic": "اللَّهُمَّ إِنِّي لَكَ صُمْتُ وَعَلَى رِزْقِكَ أَفْطَرْتُ",
      "transliteration": "Allah humma inni laka sumtu wa 'ala rizqika aftartu.",
      "translation": "O Allah! for You I fasted and I break my fast with Your sustenance."
    },
    "iftaar_dua_2": {
      "arabic": "ذَهَبَ الظَّمَأُ وَابْتَلَتِ الْعُرُوقُ وَثَبَتَ الْأَجْرُ إِنْ شَاءَ الله",
      "transliteration": "Dhahabadh-dhama', wabtallatil 'urooq, wa thabatal ajru insha Allah.",
      "translation": "The thirst has gone and the veins have been moistened and the reward has been secured, if Allah wills."
    }
  },
